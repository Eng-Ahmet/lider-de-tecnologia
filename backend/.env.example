# =======================================================
# CALLEFIX AI — DEDICATED ISOLATED PORTS & CONFIGURATION
# Verified non-conflicting ports:
# Backend API:  3880
# Frontend App: 4880
# Database:     5488
# =======================================================

PORT=3880
NODE_ENV=development
FRONTEND_URL=http://localhost:4880

# JWT Authentication
JWT_SECRET=your-secret-jwt-key-change-in-production

# Database (PostgreSQL isolated port 5488)
DATABASE_URL=postgresql://callefix:callefix123@localhost:5488/callefix_db

# Cloudflare R2 Storage (Bucket: tu-voz-ha-llegado)
R2_BUCKET_NAME=tu-voz-ha-llegado
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_PUBLIC_URL=

# Email Service
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Tu voz ha llegado - CalleFix AI" <notificaciones@callefix.malaga.es>
