# ========================================================
# Git Ignore Configuration — CalleFix AI Smart City
# ========================================================

# --------------------------------------------------------
# Environment Variables (.env files explicitly permitted)
# --------------------------------------------------------
!.env
!.env.*
!**/.env
!**/.env.*

# --------------------------------------------------------
# Dependencies
# --------------------------------------------------------
node_modules/
*/node_modules/
package-lock.json.bak
pnpm-lock.yaml.bak

# Python dependencies & virtual environments
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
env.bak/
venv.bak/

# --------------------------------------------------------
# Angular / Frontend Build Output
# --------------------------------------------------------
.angular/
*/.angular/
dist/
frontend/dist/
tmp/
out-tsc/
bazel-out/
.sass-cache/

# --------------------------------------------------------
# Logs & Process Artifacts
# --------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# --------------------------------------------------------
# Testing & Coverage
# --------------------------------------------------------
coverage/
*.lcov
.nyc_output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
testem.log

# --------------------------------------------------------
# Local Uploads & Database Volumes
# --------------------------------------------------------
backend/public/uploads/*
!backend/public/uploads/.gitkeep
pgdata/
callefix-pgdata/

# --------------------------------------------------------
# IDE & Editor Configurations
# --------------------------------------------------------
.idea/
.project
.classpath
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --------------------------------------------------------
# Operating System Files
# --------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --------------------------------------------------------
# System & Temporary Files
# --------------------------------------------------------
*.tmp
*.temp
*.swp
*.swo
*~
